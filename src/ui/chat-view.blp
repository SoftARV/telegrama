using Gtk 4.0;
using Adw 1;

template $TelegramaChatView : Adw.Bin {

  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "chat-message-new-symbolic";
        title: "Select a chat";
      };
    }

    StackPage {
      name: "messages";

      child: ScrolledWindow scroll {
        hscrollbar-policy: never;
        vexpand: true;

        child: ListView list {
          styles [
            "message-list",
          ]
        };
      };
    }
  };
}
