using Gtk 4.0;
using Adw 1;

template $TelegramaChatView : Adw.Bin {

  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "chat-message-new-symbolic";
        title: "Select a chat";
      };
    }

    StackPage {
      name: "messages";

      child: Box {
        orientation: vertical;

        ScrolledWindow scroll {
          hscrollbar-policy: never;
          vexpand: true;

          child: ListView list {
            styles [
              "message-list",
            ]
          };
        }

        Box {
          spacing: 6;
          margin-start: 8;
          margin-end: 8;
          margin-top: 6;
          margin-bottom: 8;

          Entry entry {
            hexpand: true;
            placeholder-text: "Message";
            input-hints: emoji | spellcheck;
          }

          Button send {
            icon-name: "telegrama-send-symbolic";
            tooltip-text: "Send";
            valign: center;

            styles [
              "suggested-action",
              "circular",
            ]
          }
        }
      };
    }
  };
}
