using Gtk 4.0;
using Adw 1;

template $TelegramaChatView : Adw.Bin {

  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "chat-message-new-symbolic";
        title: "Select a chat";
      };
    }

    StackPage {
      name: "messages";

      child: Box {
        orientation: vertical;

        Overlay {
          vexpand: true;

          child: ScrolledWindow scroll {
            hscrollbar-policy: never;

            child: ListView list {
              styles [
                "message-list",
              ]
            };
          };

          [overlay]
          Revealer jump_down {
            halign: end;
            valign: end;
            margin-end: 14;
            margin-bottom: 10;
            transition-type: crossfade;
            reveal-child: false;
            can-target: true;

            child: Button to_bottom_button {
              icon-name: "go-down-symbolic";
              tooltip-text: "Go to the latest message";

              styles [
                "circular",
                "jump-down",
              ]
            };
          }
        }

        Box {
          spacing: 6;
          margin-start: 8;
          margin-end: 8;
          margin-top: 6;
          margin-bottom: 8;

          Entry entry {
            hexpand: true;
            placeholder-text: "Message";
            input-hints: emoji | spellcheck;
          }

          Button send {
            icon-name: "telegrama-send-symbolic";
            tooltip-text: "Send";
            valign: center;

            styles [
              "suggested-action",
              "circular",
            ]
          }
        }
      };
    }
  };
}
