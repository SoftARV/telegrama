using Gtk 4.0;
using Adw 1;

template $TelegramaWindow : Adw.ApplicationWindow {
  title: "Telegrama";
  default-width: 900;
  default-height: 640;
  width-request: 360;
  height-request: 400;

  content: Adw.ToastOverlay toasts {
    child: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "login";
        child: Adw.Bin login_slot {};
      }

      StackPage {
        name: "main";

        child: Adw.NavigationSplitView split {
          min-sidebar-width: 260;
          max-sidebar-width: 380;

          sidebar: Adw.NavigationPage {
            title: "Chats";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton search_toggle {
                  icon-name: "system-search-symbolic";
                  tooltip-text: "Search chats";
                }

                [end]
                MenuButton {
                  icon-name: "open-menu-symbolic";
                  menu-model: primary_menu;
                  primary: true;
                  tooltip-text: "Main Menu";
                }
              }

              [top]
              SearchBar search_bar {
                child: SearchEntry search_entry {
                  hexpand: true;
                  placeholder-text: "Search chats";
                };
              }

              content: Stack sidebar_stack {
                transition-type: crossfade;

                StackPage {
                  name: "chats";

                  child: ScrolledWindow chat_scroll {
                    hscrollbar-policy: never;

                    child: ListView chat_view {
                      styles [
                        "navigation-sidebar",
                      ]
                    };
                  };
                }

                StackPage {
                  name: "empty";

                  child: Adw.StatusPage {
                    icon-name: "chat-message-new-symbolic";
                    title: "No chats yet";
                    description: "Conversations you start or receive will appear here.";

                    styles [
                      "compact",
                    ]
                  };
                }

                StackPage {
                  name: "no-results";

                  child: Adw.StatusPage no_results {
                    icon-name: "system-search-symbolic";
                    title: "No matches";

                    styles [
                      "compact",
                    ]
                  };
                }
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: "Telegrama";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle chat_title {};
              }

              content: Adw.Bin conversation_slot {};
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: "_Preferences";
      action: "app.preferences";
    }
  }

  section {
    item {
      label: "_About Telegrama";
      action: "app.about";
    }

    item {
      label: "_Quit";
      action: "app.quit";
    }
  }
}
