using Gtk 4.0;
using Adw 1;

template $TelegramaWindow : Adw.ApplicationWindow {
  title: "Telegrama";
  default-width: 900;
  default-height: 640;
  width-request: 360;
  height-request: 400;

  content: Adw.ToastOverlay toasts {
    child: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "login";
        child: Adw.Bin login_slot {};
      }

      StackPage {
        name: "main";

        child: Adw.NavigationSplitView split {
          min-sidebar-width: 260;
          max-sidebar-width: 380;

          sidebar: Adw.NavigationPage {
            title: "Chats";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                MenuButton {
                  icon-name: "open-menu-symbolic";
                  menu-model: primary_menu;
                  primary: true;
                  tooltip-text: "Main Menu";
                }
              }

              content: ScrolledWindow chat_scroll {
                hscrollbar-policy: never;

                child: ListView chat_view {
                  styles [
                    "navigation-sidebar",
                  ]
                };
              };
            };
          };

          content: Adw.NavigationPage {
            title: "Telegrama";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              content: Adw.StatusPage placeholder {
                icon-name: "chat-message-new-symbolic";
                title: "Select a chat";
                description: "Message history arrives in phase 3.";
              };
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: "_About Telegrama";
      action: "app.about";
    }

    item {
      label: "_Quit";
      action: "app.quit";
    }
  }
}
