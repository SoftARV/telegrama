using Gtk 4.0;
using Adw 1;

template $TelegramaMessageRow : Box {
  // Vertical so the line below is allocated the full row width and its halign
  // has room to mean something; a horizontal box would pack it at natural width.
  orientation: vertical;
  margin-start: 12;
  margin-end: 12;
  margin-top: 2;
  margin-bottom: 2;

  Label service_label {
    halign: center;
    justify: center;
    wrap: true;
    wrap-mode: word_char;
    visible: false;
    margin-top: 4;
    margin-bottom: 4;

    styles [
      "caption",
      "dim-label",
    ]
  }

  Box line {
    spacing: 6;

    Adw.Avatar avatar {
      size: 28;
      show-initials: true;
      valign: end;
      visible: false;
    }

    Box bubble {
      orientation: vertical;
      spacing: 1;

      styles [
        "bubble",
      ]

      Label sender_label {
        use-markup: true;
        halign: start;
        xalign: 0;
        ellipsize: end;
        single-line-mode: true;

        styles [
          "caption-heading",
        ]
      }

      Box reply_box {
        orientation: vertical;
        visible: false;
        margin-bottom: 2;

        styles [
          "reply-quote",
        ]

        Label reply_sender {
          use-markup: true;
          halign: start;
          xalign: 0;
          ellipsize: end;
          single-line-mode: true;

          styles [
            "caption-heading",
          ]
        }

        Label reply_text {
          halign: start;
          xalign: 0;
          ellipsize: end;
          single-line-mode: true;
          max-width-chars: 40;

          styles [
            "caption",
          ]
        }
      }

      Overlay media_frame {
        visible: false;
        halign: start;
        margin-bottom: 2;

        Picture media_picture {
          content-fit: cover;
          can-shrink: true;

          styles [
            "media",
          ]
        }

        [overlay]
        Box media_badge {
          halign: center;
          valign: center;
          visible: false;

          Image media_badge_icon {
            pixel-size: 32;

            styles [
              "media-badge",
            ]
          }
        }

        [overlay]
        Label media_note {
          halign: end;
          valign: end;
          margin-end: 6;
          margin-bottom: 6;
          visible: false;

          styles [
            "caption",
            "media-note",
          ]
        }
      }

      Box file_frame {
        spacing: 8;
        visible: false;
        margin-bottom: 2;

        Image file_icon {
          pixel-size: 32;
          valign: center;

          styles [
            "dim-label",
          ]
        }

        Box {
          orientation: vertical;
          valign: center;

          Label file_name {
            halign: start;
            xalign: 0;
            ellipsize: middle;
            max-width-chars: 28;
          }

          Label file_detail {
            halign: start;
            xalign: 0;

            styles [
              "caption",
              "dim-label",
            ]
          }
        }
      }

      Box body {
        spacing: 8;

        Label text_label {
          halign: start;
          xalign: 0;
          wrap: true;
          wrap-mode: word_char;
          selectable: true;
          use-markup: true;
          max-width-chars: 48;
        }

        Box footer {
          halign: end;
          valign: end;
          spacing: 4;

          Label edited_label {
            label: "edited";
            visible: false;

            styles [
              "caption",
              "dim-label",
            ]
          }

          Label time_label {
            styles [
              "caption",
              "dim-label",
            ]
          }

          Image state_icon {
            visible: false;
            pixel-size: 16;
            valign: center;

            styles [
              "dim-label",
            ]
          }
        }
      }
    }
  }
}
